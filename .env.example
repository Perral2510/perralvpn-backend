NODE_ENV=production
PORT=3000
DB_PATH=/app/data/app.sqlite
SESSION_COOKIE_NAME=perral_session
# Các domain frontend được phép gọi API bằng cookie phiên, phân tách bằng dấu phẩy.
FRONTEND_ORIGINS=https://perral.dpdns.org,https://app.perral.dpdns.org

# Gmail SMTP (use a Google App Password, never the normal account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ntlb.nhat@gmail.com
SMTP_PASS=replace-with-gmail-app-password
MAIL_FROM=PerralVPN <ntlb.nhat@gmail.com>
RESET_CODE_EXPIRES_MINUTES=10

# Payment configuration
# Hosted SePay checkout. Keep merchant credentials on the backend only.
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=replace-with-sepay-merchant-id
SEPAY_SECRET_KEY=replace-with-sepay-secret-key
SEPAY_IPN_SECRET_KEY=replace-with-sepay-ipn-secret-key
# Sandbox connectivity tests may omit X-Secret-Key. Production requires it by default.
# Set true explicitly when SePay IPN auth type is SECRET_KEY.
SEPAY_IPN_AUTH_REQUIRED=false
SEPAY_PAYMENT_METHOD=BANK_TRANSFER
# HTTPS listener for direct SePay IPN on port 3001.
SEPAY_HTTPS_PORT=3001
SEPAY_TLS_KEY_PATH=/etc/sepay/tls/privkey.pem
SEPAY_TLS_CERT_PATH=/etc/sepay/tls/fullchain.pem

PAYMENT_BANK_NAME=MB Bank
PAYMENT_BANK_ACCOUNT=0123456789
PAYMENT_BANK_OWNER=NGUYEN DUC ANH
PAYMENT_TRANSFER_PREFIX=DAV
ADMIN_API_KEY=replace-with-a-long-random-secret

# 3x-ui server-to-server provisioning. Keep the token only on the backend VPS.
XUI_BASE_URL=https://panel.example.com
XUI_API_TOKEN=replace-with-an-admin-scope-3x-ui-api-token

# Legacy 3x-ui subscription service settings; custom VLESS subscription uses PUBLIC_API_URL.
XUI_SUB_BASE_URL=https://panel.example.com:2096
XUI_SUB_PATH=/sub/
XUI_JSON_PATH=/json/
XUI_CLASH_PATH=/clash/

# Public backend URL used by VPN apps to fetch the custom multi-client subscription.
PUBLIC_API_URL=https://api.example.com

# One custom VLESS profile per plan.
XUI_VLESS_PROFILES={"vina-khong-nen":{"address":"vnpt.theworkpc.com","port":443,"path":"/tiktok4g","security":"tls","encryption":"none","host":"perral.de5.net","fp":"chrome","type":"ws","sni":"perral.de5.net","remark":"PERRAL"}}

XUI_TIMEOUT_MS=10000
# Inbound ID 1 is the VLESS inbound shown in the current 3x-ui configuration.
XUI_INBOUND_IDS_BY_PLAN={"vina-khong-nen":[1]}
XUI_DEFAULT_INBOUND_IDS=
XUI_DEVICE_LIMIT_AS_IP_LIMIT=false

# MXH TCP-only mode: only the selected client emails have UDP denied; TCP uses the normal outbound.
XUI_MXH_TCP_ONLY_ENABLED=true
XUI_MXH_PLAN_SLUGS=vina-khong-nen-mxh
XUI_MXH_UDP_DENY_RULE_TAG=perralvpn-mxh-udp-deny
XUI_MXH_UDP_DENY_OUTBOUND_TAG=perralvpn-mxh-udp-deny
XUI_OUTBOUND_TEST_URL=https://www.google.com/generate_204
