NODE_ENV=production
PORT=3000
DB_PATH=/app/data/app.sqlite
SESSION_COOKIE_NAME=perral_session
# Custom domain của frontend Render được phép gọi API bằng cookie phiên.
FRONTEND_ORIGIN=https://app.perral.dpdns.org

# Gmail SMTP (use a Google App Password, never the normal account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ntlb.nhat@gmail.com
SMTP_PASS=replace-with-gmail-app-password
MAIL_FROM=PerralVPN <ntlb.nhat@gmail.com>
RESET_CODE_EXPIRES_MINUTES=10

# Payment configuration (replace demo values before production)
PAYMENT_BANK_NAME=MB Bank
PAYMENT_BANK_ACCOUNT=0123456789
PAYMENT_BANK_OWNER=NGUYEN DUC ANH
PAYMENT_TRANSFER_PREFIX=DAV
# Required only for the private admin endpoint that confirms a bank transfer.
ADMIN_API_KEY=replace-with-a-long-random-secret

# 3x-ui server-to-server provisioning. Keep the token only on the backend VPS.
XUI_BASE_URL=https://panel.example.com
XUI_API_TOKEN=replace-with-an-admin-scope-3x-ui-api-token
# Public subscription origin: https://panel.example.com:2096 or a reverse-proxy hostname.
XUI_SUB_BASE_URL=https://panel.example.com:2096
XUI_SUB_PATH=/sub/
XUI_JSON_PATH=/json/
XUI_CLASH_PATH=/clash/
XUI_TIMEOUT_MS=10000
# Keyed by plan slug (or numeric plan id), for example {"vn-basic":[3],"vn-pro":[3,5]}.
XUI_INBOUND_IDS_BY_PLAN={"vn-basic":[3],"vn-pro":[3],"lifetime-standard":[3,5],"lifetime-premium":[3,5],"global-basic":[5],"global-ultra":[5]}
# Used when a plan has no key in XUI_INBOUND_IDS_BY_PLAN.
XUI_DEFAULT_INBOUND_IDS=
# Set false if plan device limits should not become 3x-ui IP limits.
XUI_DEVICE_LIMIT_AS_IP_LIMIT=false
